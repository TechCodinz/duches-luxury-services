{
  "expo": {
    "name": "Fitness Option",
    "slug": "fitness-option",
    "scheme": "fitnessoption",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": ["expo-router"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techcodinz.fitnessoption"
    },
    "android": {
      "package": "com.techcodinz.fitnessoption",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
